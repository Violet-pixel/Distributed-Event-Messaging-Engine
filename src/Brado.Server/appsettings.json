{
  "Urls": "http://0.0.0.0:5080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Broker": {
    "Host": "0.0.0.0",
    "Port": 7420,
    "MaxConnections": 2048,
    "MaxPayloadBytes": 4194304,
    "OutboundQueueCapacity": 8192,
    "RetainedMessagesPerTopic": 100000,
    "DefaultPrefetch": 64,
    "AckTimeout": "00:00:30",
    "MaxDeliveryAttempts": 5,
    "DeadLetterSuffix": ".dlq",
    "PersistMessages": true
  },
  "EventStore": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/brado-events.db",
    "SnapshotEvery": 50
  },
  "ReadModel": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/brado-read.db"
  },
  "Messaging": {
    "Mode": "InProcess",
    "BrokerHost": "localhost",
    "BrokerPort": 7420,
    "ClientName": "brado-workers"
  },
  "Outbox": {
    "BatchSize": 200,
    "PollingInterval": "00:00:00.500",
    "Lease": "00:00:30",
    "BaseRetryDelay": "00:00:01",
    "MaxRetryDelay": "00:05:00",
    "DispatchedRetention": "7.00:00:00"
  },
  "Projections": {
    "BatchSize": 500,
    "PollingInterval": "00:00:01"
  },
  "Saga": {
    "Enabled": true,
    "Topic": "orders.events",
    "PaymentFailureRate": 0.08,
    "StockFailureRate": 0.10,
    "SimulatedLatencyMs": 120
  },
  "Simulation": {
    "Ambient": false,
    "AmbientOrdersPerMinute": 12,
    "AmbientMessagesPerSecond": 40
  }
}
